	column is_cancelled
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 7b644be2-1be8-4270-a37b-6fe6374b8b1a
		summarizeBy: none
		sourceColumn: is_cancelled

		annotation SummarizationSetBy = Automatic

	column has_customer
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 9822d2b2-a982-4f3a-88c0-6ad281e7ae57
		summarizeBy: none
		sourceColumn: has_customer

		annotation SummarizationSetBy = Automatic

	column is_fully_cancelled_order
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2e5ae98d-a6e4-4c84-bf12-8cdd40b684a4
		summarizeBy: none
		sourceColumn: is_fully_cancelled_order

		annotation SummarizationSetBy = Automatic

	column invoice_day = DATEVALUE(fact_sales[date])
		formatString: m/d/yyyy
		lineageTag: a7523c84-45a3-4d40-949f-ce1c19d316dc
		summarizeBy: none

		changedProperty = DataType

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'First Purchase Date' =
			
			CALCULATE(
			    MIN('fact_sales'[invoice_day]),
			    ALLEXCEPT('fact_sales', 'fact_sales'[customer_id]),
			    'fact_sales'[is_cancelled] = FALSE()
			)
		formatString: General Date
		lineageTag: fe767e09-f0c0-4c93-b49d-21bd33fcfa4a
		summarizeBy: none

		variation Variation
			isDefault
			relationship: ea8bf1be-6e5f-414e-9cb3-80da0155de61
			defaultHierarchy: LocalDateTable_93605032-11bf-4ea8-a7a6-9da22bc25a9b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Customer Type' =
			
			IF(
			    ISBLANK('fact_sales'[customer_id]) ||
			    ISBLANK('fact_sales'[First Purchase Date]) ||
			    'fact_sales'[is_cancelled] = TRUE(),
			    BLANK(),
			    IF(
			        'fact_sales'[invoice_day] = 'fact_sales'[First Purchase Date],
			        "New Customer",
			        "Returning Customer"
			    )
			)
		lineageTag: a10ce983-11a2-477f-b983-592213214e58
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Admin\Downloads\online-retail-analysis-main\retail-cohort-clv-analysis\Data\processed\powerbi\fact_sales.csv"),[Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"date", type datetime}, {"invoice", type text}, {"stock_code", type text}, {"description", type text}, {"country", type text}, {"customer_id", Int64.Type}, {"quantity", Int64.Type}, {"price", type number}, {"line_revenue", type number}, {"is_cancelled", type logical}, {"has_customer", type logical}, {"is_fully_cancelled_order", type logical}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

