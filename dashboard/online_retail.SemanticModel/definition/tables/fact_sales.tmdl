table fact_sales
	lineageTag: c76e2059-f086-4ae3-ba10-1c1933b3ac1e

	measure 'Revenue Without Customer ID' =
			
			CALCULATE(
			    [Net Revenue],
			    FILTER(
			        'fact_sales',
			        ISBLANK('fact_sales'[customer_id])
			    )
			)
		lineageTag: fcb8a01b-7eee-43c5-8984-fa450033c094

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue With Customer ID' =
			
			CALCULATE(
			    [Net Revenue],
			    NOT(ISBLANK('fact_sales'[customer_id]))
			)
		lineageTag: 406cdc85-c4a0-4e98-941a-d208a1c50785

		annotation PBI_FormatHint = {"isGeneralNumber":true}

